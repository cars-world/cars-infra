{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@cars-world/cars-infra",

  // 1-2 sentence summary about this repo.
  "summary": "Azure resources of the cars application, shared by the stages dev, test and prod in one resource group rg-cars: Node.js scripts bootstrap.js (providers, resource group), deploy.js (Bicep components with what-if and a yes), changed.js and test.js (unit tests, Bicep builds); the workflows plan (what-if on pull requests) and deploy (after an approval, as id-cars-github-infra).",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure resources: resource group rg-cars, Log Analytics, container registry crcars, VNet with a subnet and NSG per node pool, AKS cluster aks-cars with node pools system, origin, custom, stopped every evening by a Logic App; identities for GitHub Actions through OIDC and the Key Vault kv-cars-github",
    "Data per side: SQL servers sql-cars-<side> with a Basic database per stage, storage accounts stcars<side> with a container per stage, private endpoints and DNS zones, a workload identity per master and stage, Entra only, no keys",
    "AKS: Entra RBAC, workload identity, Azure CNI overlay with Cilium, taints per side, AcrPull, application routing add-on with Gateway API",
    "Bicep in a component layout, one <component>.bicepparam each, what-if before every deploy, Germany West Central"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "cars-deployment": "deploys the apps into the cluster aks-cars created here, onto the node pools origin and custom, and pulls the images from crcars; federates the service accounts master with the identities id-cars-<side>-master-<stage>"
    }
  }
}
